public class Main {
    public static void main(String[] args) {
        int[] arr = {2, 2, 1, 1, 2, 2, 2};

        int candidate = 0;
        int count = 0;

        for (int x : arr) {
            if (count == 0)
                candidate = x;

            count += (x == candidate) ? 1 : -1;
        }

        count = 0;

        for (int x : arr) {
            if (x == candidate)
                count++;
        }

        if (count > arr.length / 2)
            System.out.println(candidate);
        else
            System.out.println("No Majority Element");
    }
}
