public class Main {
    public static void main(String[] args) {
        int[] arr = {1, 2, 4, 5, 6};
        int n = 6;

        int total = n * (n + 1) / 2;
        int sum = 0;

        for (int x : arr)
            sum += x;

        System.out.println("Missing Number: " + (total - sum));
    }
}
