public class Main {
    static int N = 4;

    static boolean solve(int[][] maze, int x, int y, int[][] path) {
        if (x == N - 1 && y == N - 1) {
            path[x][y] = 1;
            return true;
        }

        if (x < N && y < N && x >= 0 && y >= 0 &&
            maze[x][y] == 1 && path[x][y] == 0) {

            path[x][y] = 1;

            if (solve(maze, x + 1, y, path) ||
                solve(maze, x, y + 1, path))
                return true;

            path[x][y] = 0;
        }

        return false;
    }

    public static void main(String[] args) {
        int[][] maze = {
            {1, 0, 0, 0},
            {1, 1, 0, 1},
            {0, 1, 0, 0},
            {1, 1, 1, 1}
        };

        int[][] path = new int[N][N];

        if (solve(maze, 0, 0, path)) {
            for (int[] row : path) {
                for (int x : row)
                    System.out.print(x + " ");

                System.out.println();
            }
        } else {
            System.out.println("No Solution");
        }
    }
}
